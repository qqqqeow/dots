// ────────────── Niri Configuration (Clean & Modular) ──────────────
// Documentation: https://github.com/YaLTeR/niri/wiki/Configuration:-Overview

// ─── Ввод и клавиатура ───
input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }
}

// ─── Мониторы ───
output "eDP-1" {
    scale 1.0
}

// ─── Разметка (Layout) ───
layout {
    gaps 12
    center-focused-column "never"

    default-column-width {
        proportion 0.5
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        off
    }

    border {
        width 1
        active-color "#7aa2f7"
        inactive-color "rgba(255, 255, 255, 0.12)"
    }
}

// ─── Плавная физика анимаций (Spring Physics) ───
animations {
    slowdown 1.0

    workspace-switch {
        spring damping-ratio=0.85 stiffness=850 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=850 epsilon=0.0001
    }

    window-open {
        duration-ms 200
        curve "ease-out-cubic"
    }

    window-close {
        duration-ms 180
        curve "ease-out-quad"
    }

    window-movement {
        spring damping-ratio=0.85 stiffness=850 epsilon=0.0001
    }
}

// ─── Правила окон и слоёв ───
window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
}

window-rule {
    match app-id="^pavucontrol$"
    open-floating true
    default-column-width { fixed 650; }
    default-window-height { fixed 500; }
}

// Аппаратное размытие фона (Blur) под баром и шторкой
layer-rule {
    match namespace="^waybar$"
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^swaync-control-center$"
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^swaync-notification-window$"
    background-effect {
        blur true
        xray false
    }
}

// ─── Автозапуск сервисов ───
spawn-at-startup "waybar"
spawn-at-startup "swaync"
spawn-at-startup "swayosd-server"
spawn-at-startup "awww-daemon"
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--primary" "--watch" "cliphist" "store"
spawn-at-startup "wl-clip-persist" "--clipboard" "both"
spawn-at-startup "spice-vdagent"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "sh" "-c" "~/.config/niri/scripts/init-wallpaper.sh"

// ─── Горячие клавиши ───
binds {
    // Приложения
    Mod+Return                          { spawn "kitty"; }
    Mod+Space                           { spawn "fuzzel"; }
    Mod+V                               { spawn-sh "cliphist list | fuzzel --dmenu --prompt '📋 ' | cliphist decode | wl-copy"; }
    Mod+N                               { spawn "swaync-client" "-t" "-sw"; } // Центр управления и уведомлений SwayNC
    Mod+B                               { spawn "firefox"; }
    Mod+E                               { spawn "nautilus"; }

    // Меню и переключение обоев (Awww / Wallhaven / mpvpaper видео)
    Mod+W                               { spawn-sh "~/.config/niri/scripts/wallpaper-manager.sh menu"; }
    Mod+Shift+W                         { spawn-sh "~/.config/niri/scripts/wallpaper-manager.sh next"; }

    // Управление окнами
    Mod+Q                               { close-window; }
    Mod+Shift+E                         { quit; }
    Mod+F                               { fullscreen-window; }
    Mod+Shift+Space                     { toggle-window-floating; }
    Mod+O                               { toggle-overview; }

    // Навигация окнами (стрелки: между окнами, колонками и мониторами)
    Mod+Left                            { focus-column-or-monitor-left; }
    Mod+Right                           { focus-column-or-monitor-right; }
    Mod+Up                              { focus-window-or-workspace-up; }
    Mod+Down                            { focus-window-or-workspace-down; }

    // Альтернативная навигация (HJKL)
    Mod+H                               { focus-column-or-monitor-left; }
    Mod+L                               { focus-column-or-monitor-right; }
    Mod+K                               { focus-window-or-workspace-up; }
    Mod+J                               { focus-window-or-workspace-down; }

    // Перемещение окон в ленте (стрелки с Shift)
    Mod+Shift+Left                      { move-column-left-or-to-monitor-left; }
    Mod+Shift+Right                     { move-column-right-or-to-monitor-right; }
    Mod+Shift+Up                        { move-window-up-or-to-workspace-up; }
    Mod+Shift+Down                      { move-window-down-or-to-workspace-down; }

    // Альтернативное перемещение (Shift + HJKL)
    Mod+Shift+H                         { move-column-left-or-to-monitor-left; }
    Mod+Shift+L                         { move-column-right-or-to-monitor-right; }
    Mod+Shift+K                         { move-window-up-or-to-workspace-up; }
    Mod+Shift+J                         { move-window-down-or-to-workspace-down; }

    // Переключение рабочих столов (циклически и по номерам)
    Mod+Page_Down                       { focus-workspace-down; }
    Mod+Page_Up                         { focus-workspace-up; }
    Mod+1                               { focus-workspace 1; }
    Mod+2                               { focus-workspace 2; }
    Mod+3                               { focus-workspace 3; }
    Mod+4                               { focus-workspace 4; }
    Mod+5                               { focus-workspace 5; }

    // Перемещение окон на рабочие столы
    Mod+Shift+1                         { move-column-to-workspace 1; }
    Mod+Shift+2                         { move-column-to-workspace 2; }
    Mod+Shift+3                         { move-column-to-workspace 3; }
    Mod+Shift+4                         { move-column-to-workspace 4; }
    Mod+Shift+5                         { move-column-to-workspace 5; }

    // Переключение между физическими мониторами
    Mod+BracketLeft                     { focus-monitor-previous; }
    Mod+BracketRight                    { focus-monitor-next; }
    Mod+Shift+BracketLeft               { move-column-to-monitor-previous; }
    Mod+Shift+BracketRight              { move-column-to-monitor-next; }

    // Размеры колонок
    Mod+R                               { switch-preset-column-width; }
    Mod+Minus                           { set-column-width "-10%"; }
    Mod+Equal                           { set-column-width "+10%"; }

    // Скриншоты
    Print                               { spawn-sh "grim -g \"$(slurp)\" - | wl-copy"; }
    Shift+Print                         { spawn-sh "grim ~/Изображения/screenshot_$(date +%Y%m%d_%H%M%S).png"; }

    // Управление мультимедиа через SwayOSD и playerctl
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower"; }
    XF86AudioMute         allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "swayosd-client" "--input-volume" "mute-toggle"; }

    // Медиа клавиши (Play/Pause, Next, Prev)
    XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext         allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev         allow-when-locked=true { spawn "playerctl" "previous"; }

    // Яркость экрана через SwayOSD
    XF86MonBrightnessUp   allow-when-locked=true { spawn "swayosd-client" "--brightness" "raise"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "swayosd-client" "--brightness" "lower"; }
}
