{
    "layer": "top",
    "position": "top",
    "height": 26,
    "margin-top": 4,
    "margin-bottom": 0,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,

    "modules-left": [
        "custom/launcher",
        "niri/workspaces",
        "niri/window"
    ],
    "modules-center": [
        "mpris",
        "clock",
        "custom/catwalk"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "tray",
        "custom/notification"
    ],

    // Вызов лаунчера Fuzzel
    "custom/launcher": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "fuzzel"
    },

    // Воркспейсы Niri (кликабельные, с поддержкой колесика мыши)
    "niri/workspaces": {
        "format": "{index}",
        "disable-click": false,
        "enable-bar-scroll": true,
        "all-outputs": true
    },

    // Название активного окна
    "niri/window": {
        "format": "{title}",
        "max-length": 25,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹 $1",
            "(.*) - Discord": "󰙯 $1",
            "(.*) - Kitty": " $1",
            "(.*) - Steam": "󰓓 $1"
        }
    },

    // Музыкальный плеер MPRIS с управлением по клику
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "dynamic-order": ["title", "artist"],
        "dynamic-separator": " • ",
        "max-length": 30,
        "player-icons": {
            "default": "󰎆",
            "spotify": "󰓇",
            "firefox": "󰈹",
            "chromium": "󰊯",
            "mpv": "󰎇"
        },
        "status-icons": {
            "paused": "󰏤"
        },
        "on-click": "play-pause",
        "on-click-right": "next",
        "on-click-middle": "previous",
        "on-scroll-up": "next",
        "on-scroll-down": "previous",
        "tooltip-format": "{player} ({status}): {title} - {artist} [{position}/{length}]"
    },

    // Часы и дата
    "clock": {
        "interval": 1,
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃭 {:%d %B, %A}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    // Анимированный котик Catwalk (отслеживает загрузку CPU)
    "custom/catwalk": {
        "exec": "~/.config/waybar/scripts/catwalk.py",
        "return-type": "json",
        "interval": 1,
        "format": "{}",
        "on-click": "kitty -e btop"
    },

    // Звук
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 3,
        "on-click": "swayosd-client --output-volume mute-toggle",
        "on-click-right": "pavucontrol"
    },

    // Интернет и сеть
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 Wired",
        "format-linked": "󰈀 No IP",
        "format-disconnected": "󰤭 Off",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "swaync-client -t -sw"
    },

    // Батарея
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },

    // Системный трей
    "tray": {
        "icon-size": 13,
        "spacing": 6
    },

    // Центр управления и уведомления SwayNC со счетчиком
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󱅫",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}
